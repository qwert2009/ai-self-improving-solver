# Senior Project - AI Self-Improving System
# Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================
# API Keys (REQUIRED - get from providers)
# ============================================

# DeepSeek API: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Secret key for session management (change in production!)
SECRET_KEY=your-secret-key-change-in-production

# ============================================
# API Endpoints (default values)
# ============================================
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ============================================
# Model Settings
# ============================================
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-2.0-flash-lite

# ============================================
# Debug & Logging
# ============================================
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite+aiosqlite:///./senior_project.db

# ============================================
# Proxy (optional - uncomment if needed)
# ============================================
# HTTP_PROXY=http://host.docker.internal:10808
# HTTPS_PROXY=http://host.docker.internal:10808

# ============================================
# Redis (optional)
# ============================================
# REDIS_URL=redis://localhost:6379
