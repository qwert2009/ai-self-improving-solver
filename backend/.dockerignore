# Backend .dockerignore - Security and build optimization

# Environment files (NEVER include in Docker)
.env
.env.*
*.env
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Database files (will be created in volume)
*.db
*.sqlite
*.sqlite3
data/

# Build artifacts
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage/
.nyc_output/

# Logs
*.log
logs/

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation
*.md
!requirements.txt

# Temporary files
*.tmp
*.bak
*.backup
