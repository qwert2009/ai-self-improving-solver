# Senior Project - Environment Configuration
# Production-Ready Template
# ============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!
# ============================================

# ============================================
# API Keys (REQUIRED for AI functionality)
# ============================================
# Get DeepSeek API: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Get Google Gemini API: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# ============================================
# Security (REQUIRED for production)
# ============================================
# Generate a strong secret key for session management
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ============================================
# API Endpoints (Default values - change if needed)
# ============================================
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ============================================
# Model Settings (Optional - defaults provided)
# ============================================
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-2.0-flash-lite

# ============================================
# Debug & Logging (Set false in production)
# ============================================
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# Database Configuration
# ============================================
# SQLite (default - for development)
DATABASE_URL=sqlite+aiosqlite:///./data/senior_project.db

# PostgreSQL (for production - uncomment and configure)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/senior_project

# ============================================
# Server Configuration
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============================================
# CORS Settings (Optional)
# ============================================
# Comma-separated list of allowed origins
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# Rate Limiting (Optional)
# ============================================
# RATE_LIMIT_PER_MINUTE=60

# ============================================
# Proxy Configuration (Optional - for restricted networks)
# ============================================
# HTTP_PROXY=http://host.docker.internal:10808
# HTTPS_PROXY=http://host.docker.internal:10808

# ============================================
# Redis (Optional - for caching/sessions)
# ============================================
# REDIS_URL=redis://localhost:6379

# ============================================
# Monitoring (Optional)
# ============================================
# ENABLE_METRICS=false
# METRICS_PORT=9090
