# Frontend .dockerignore - Security and build optimization

# Environment files (NEVER include in Docker)
.env
.env.*
*.env
!.env.example

# Node modules (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (will be created in container)
build/
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose*.yml
.dockerignore
nginx.conf

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.bak
*.backup

# Documentation
*.md
!package.json
!package-lock.json
